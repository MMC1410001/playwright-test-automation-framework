    "/recordings": {
      "get": {
        "summary": "Get Recordings",
        "description": "Fetch recordings from MongoDB, optionally filtered by batch_id\n\nQuery Parameters:\n- batch_id: Optional filter to get recordings for a specific batch\n- limit: Maximum number of recordings to return (default: 100)\n\nReturns:\n{\n    \"success\": true,\n    \"count\": 10,\n    \"recordings\": [\n        {\n            \"session_id\": \"...\",\n            \"batch_id\": \"...\",\n            \"room\": {...},\n            \"sip\": {...},\n            \"transcript\": [...],\n            \"duration\": {...},\n            \"started_at\": \"...\",\n            \"ended_at\": \"...\"\n        }\n    ]\n}\n\nExamples:\n- GET /recordings - Get all recordings (up to 100)\n- GET /recordings?batch_id=abc123 - Get recordings for specific batch\n- GET /recordings?limit=50 - Get latest 50 recordings",
        "operationId": "get_recordings_recordings_get",
        "parameters": [
          {
            "name": "batch_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Batch Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
