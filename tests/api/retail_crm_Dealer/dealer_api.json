    "/dealers/{dealer_id}/sales/overall-summary": {
      "get": {
        "tags": [
          "graphs"
        ],
        "summary": "Overall Sales Summary",
        "description": "Overall Sales Summary\n\n- MTD: weekly buckets with last bucket truncated to asOfDate (e.g., 15th-19th)\n- PREVIOUS MONTH: fixed weekly buckets (full month)\n- YTD: Q1-Q4 always (FY Apr-Mar), missing quarters filled with 0\n- QTD / PREVIOUS QUARTER: months in window",
        "operationId": "overall_sales_summary_dealers__dealer_id__sales_overall_summary_get",
        "parameters": [
          {
            "name": "dealer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dealer Id"
            }
          },
          {
            "name": "asOfDate",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD; defaults to dataset max invoice_date",
              "title": "Asofdate"
            },
            "description": "YYYY-MM-DD; defaults to dataset max invoice_date"
          },
          {
            "name": "distributionChannel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated channel ids (e.g., 11,12) or All",
              "default": "All",
              "title": "Distributionchannel"
            },
            "description": "Comma-separated channel ids (e.g., 11,12) or All"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
