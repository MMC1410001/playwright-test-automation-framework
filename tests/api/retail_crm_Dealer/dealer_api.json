    "/dealers/{dealer_id}/sales/products/search": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Product Sales Report Search",
        "description": "Product Sales Report Search\n- category/subBrand/channel accept comma-separated multi-selects\n  Example:\n    category=Interior,Exterior\n    subBrand=One,Calista\n    channel=11,12\n- 'All' means no filter for that dimension\n- Returns VALID FILTER VALUES from DB (no misses)",
        "operationId": "product_sales_report_search_dealers__dealer_id__sales_products_search_get",
        "parameters": [
          {
            "name": "dealer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dealer Id"
            }
          },
          {
            "name": "periodType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "MTD | YTD | QTD | PREVIOUS MONTH | PREVIOUS QUARTER | CUSTOM",
              "default": "MTD",
              "title": "Periodtype"
            },
            "description": "MTD | YTD | QTD | PREVIOUS MONTH | PREVIOUS QUARTER | CUSTOM"
          },
          {
            "name": "asOfDate",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD; used for non-CUSTOM windows",
              "title": "Asofdate"
            },
            "description": "YYYY-MM-DD; used for non-CUSTOM windows"
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD (required for CUSTOM)",
              "title": "Startdate"
            },
            "description": "YYYY-MM-DD (required for CUSTOM)"
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "YYYY-MM-DD (required for CUSTOM)",
              "title": "Enddate"
            },
            "description": "YYYY-MM-DD (required for CUSTOM)"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated category names or All. Values = Collaterals, Colorants, Company PS, Enamels, Exterior, Inst. Ext. Waterproofing Spl, Institutional Exterior Paints Regular, Institutional Exterior Waterproofing Reg, Institutional Interior Paints Regular, Institutional Metal Regular, Interior, Painting Tools, Unknown, Waterproofing, Wood Paints",
              "default": "All",
              "title": "Category"
            },
            "description": "Comma-separated category names or All. Values = Collaterals, Colorants, Company PS, Enamels, Exterior, Inst. Ext. Waterproofing Spl, Institutional Exterior Paints Regular, Institutional Exterior Waterproofing Reg, Institutional Interior Paints Regular, Institutional Metal Regular, Interior, Painting Tools, Unknown, Waterproofing, Wood Paints"
          },
          {
            "name": "subBrand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated sub-brand names or All. Values = Alldry, Allwood, Allwood Pro, Artist, Calista, Collaterals,One, Others, Prime, Sample Kit, Style",
              "default": "All",
              "title": "Subbrand"
            },
            "description": "Comma-separated sub-brand names or All. Values = Alldry, Allwood, Allwood Pro, Artist, Calista, Collaterals,One, Others, Prime, Sample Kit, Style"
          },
          {
            "name": "distributionChannel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated channel ids (as strings) or All. Values = 10, 11, 12, 21",
              "default": "All",
              "title": "Distributionchannel"
            },
            "description": "Comma-separated channel ids (as strings) or All. Values = 10, 11, 12, 21"
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "value",
                "volume",
                "growth"
              ],
              "type": "string",
              "description": "value | volume | growth",
              "default": "value",
              "title": "Sortby"
            },
            "description": "value | volume | growth"
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "description": "asc | desc",
              "default": "desc",
              "title": "Sortorder"
            },
            "description": "asc | desc"
          },
          {
            "name": "downloadReport",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, returns ALL rows (ignores pagination)",
              "default": false,
              "title": "Downloadreport"
            },
            "description": "If true, returns ALL rows (ignores pagination)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "0-based page index: 0=first page",
              "default": 0,
              "title": "Page"
            },
            "description": "0-based page index: 0=first page"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 25,
              "title": "Pagesize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
