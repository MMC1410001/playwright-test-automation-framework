# Every target below has a public demo default, so the smoke suite runs with an
# empty .env. Fill these in only when pointing at your own system under test.

# Default base URL, used by playwright.config.js and tests/smoke.spec.js
# (default: https://www.saucedemo.com)
BASE_URL=UPDATE HERE

# --- E2E targets ---
# (default: https://www.saucedemo.com)
SAAS_URL=UPDATE HERE
# (default: https://the-internet.herokuapp.com)
ADVISOR_URL=UPDATE HERE
# (default: https://the-internet.herokuapp.com)
VOICE_URL=UPDATE HERE
# (default: https://the-internet.herokuapp.com)
PHARMA_URL=UPDATE HERE

# --- API targets ---
# (default: https://jsonplaceholder.typicode.com)
CRM_API_URL=UPDATE HERE
# (default: https://reqres.in)
DEALER_API_URL=UPDATE HERE
# (default: https://httpbin.org)
CHATBOT_API_URL=UPDATE HERE
# (default: https://httpbin.org)
BILLING_API_URL=UPDATE HERE
# (default: https://httpbin.org)
PHARMA_API_URL=UPDATE HERE
# (default: https://reqres.in)
VOICE_API_URL=UPDATE HERE
# (default: https://httpbin.org)
OUTBOUND_API_URL=UPDATE HERE
# (default: https://quickpizza.grafana.com)
TICKETING_URL=UPDATE HERE
# (default: https://jsonplaceholder.typicode.com)
WEALTH_API_URL=UPDATE HERE

# --- Auth ---
# Bearer token for API suites that hit protected endpoints. Leave unset to run
# unauthenticated against the public defaults.
TEST_AUTH_TOKEN=UPDATE HERE

# Firebase Web API key, used by tests/api/firebaseAuth.js to exchange a custom
# token for an ID token. See tests/api/firebaseAuth_Documentation.md.
FIREBASE_API_KEY=UPDATE HERE

# Path to a Google service-account JSON, if you use the Python token-minting helper.
# Never commit the file itself - *.json service accounts are gitignored.
GOOGLE_APPLICATION_CREDENTIALS=UPDATE HERE

# RS256 private key path for minting test JWTs (tests/api/retail_crm_chatbot/sfa-token.js).
# Keep this outside the repository, e.g. ~/.retail-crm-sfa/sfa_jwt_private.pem
SFA_JWT_PRIVATE_KEY_PATH=UPDATE HERE

# --- Run behaviour ---
# Set to any value to run with a visible browser instead of headless.
HEADED=UPDATE HERE
